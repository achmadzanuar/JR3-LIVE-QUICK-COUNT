# Recommended on Vercel: short-lived OIDC, no private key. Production only.
# VERCEL_ENV is supplied by Vercel itself; do not override it.
GOOGLE_AUTH_MODE=vercel_oidc
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=jr3-vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
GCP_SERVICE_ACCOUNT_EMAIL=

# Alternative where keys are allowed: GOOGLE_AUTH_MODE=service_account
# Keep the whole JSON in a Sensitive Vercel variable, never in Git.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Defaults below already point to the user-supplied dummy spreadsheet.
GOOGLE_SPREADSHEET_ID=1SxVEYKqNxORxU3oqHrEFWq4_eJio0eFDEU8_g16gZAk
GOOGLE_SHEET_GID=861129643
ELECTION_MODE=dummy

# Optional; blank means unknown or automatic exact header verification.
REGISTERED_VOTERS=
CHOICE_HEADER=
ADDRESS_HEADER=
TIMESTAMP_HEADER=

# Optional reviewed exceptions. Sensitive Production variable; never commit real
# source rows/addresses. See docs/ADDRESS-CORRECTIONS.md for the schema.
GOOGLE_ADDRESS_CORRECTIONS_JSON=
